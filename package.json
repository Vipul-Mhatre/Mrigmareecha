{
  "name": "mrigmareecha",
  "version": "1.0.0",
  "description": "Mrigmareecha monorepo — Next.js frontend + Node.js backend",
  "private": true,
  "workspaces": [
    "packages/client",
    "packages/api"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:api": "npm run dev --workspace=api",
    "test:api": "node -e \"const store = require('./packages/api/src/store'); console.log('Audit chain length:', store.auditTrail.chain.length); console.log(store.auditTrail.verifyIntegrity());\"",
    "lint": "lerna run lint --parallel",
    "lint:fix": "lerna run lint:fix --parallel",
    "build": "lerna run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9",
    "lerna": "^8",
    "lint-staged": "^15"
  },
  "lint-staged": {
    "packages/client/**/*.{ts,tsx,js,jsx}": [
      "npm run lint:fix --workspace=client --"
    ],
    "packages/api/**/*.{js,mjs,cjs,json}": [
      "npm run lint:fix --workspace=api --"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
